Complete Python code
Create a file named project_car_finder.py and paste the following code into it.


from drafter import *
from dataclasses import dataclass


# Represents one car in the project car database.
@dataclass
class Car:
    make: str
    model: str
    year: int
    region: str
    transmission: str


# Stores the user's selections and the car database.
@dataclass
class State:
    cars: list[Car]
    regions: list[str]
    year_min: int
    year_max: int
    transmission: str
    make: str
    model: str


